{
  "name": "privateqa-community",
  "version": "0.1.0",
  "type": "module",
  "description": "Write tests in natural language, run them with Playwright. Plugin-extensible.",
  "license": "MIT",
  "bin": {
    "privateqa": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/core/plugin.js",
      "types": "./dist/core/plugin.d.ts"
    },
    "./errors": {
      "import": "./dist/core/errors.js",
      "types": "./dist/core/errors.d.ts"
    },
    "./base": {
      "import": "./dist/base.js",
      "types": "./dist/base.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "SYNTAX.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "map": "tsx src/cli.ts map",
    "preprocess": "tsx src/cli.ts preprocess",
    "compile": "tsx src/cli.ts compile",
    "run": "tsx src/cli.ts run",
    "report": "tsx src/cli.ts report",
    "evolution": "tsx src/cli.ts evolution",
    "api": "tsx src/cli.ts api",
    "test": "playwright test",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "keywords": [
    "playwright",
    "testing",
    "natural-language",
    "scenario",
    "e2e",
    "test-generator",
    "automation",
    "no-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrivateQA/privateqa-community.git"
  },
  "homepage": "https://github.com/PrivateQA/privateqa-community#readme",
  "bugs": {
    "url": "https://github.com/PrivateQA/privateqa-community/issues"
  },
  "author": "",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
