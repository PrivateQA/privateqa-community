## fwkTest - variables d'environnement (exemple)
## Copie ce fichier en `.env` (non committé) et adapte.

# ---- Ollama (On-Prem) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=mistral

# ---- Exécution Playwright ----
# true | false
HEADLESS=false

# ---- Output ----
# Dossier de sortie (screenshots/logs/récap)
TEST_OUTPUT_DIR=test-output

# ---- Credentials (exemples) ----
# Utilise des noms explicites par appli / environnement.
APP_USERNAME=
APP_PASSWORD=

